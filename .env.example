# Application Settings
DEBUG=True
SECRET_KEY=django-insecure-brevo-survey-campaign-platform-key-change-in-prod-2026
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database (Leave blank or 'sqlite' for local zero-dependency development; set postgres URL for production)
DATABASE_URL=
# Example PostgreSQL for Docker: postgres://postgres:postgres@db:5432/email_platform

# Encryption Key for sensitive fields (Contact login passwords, SMTP passwords, ODK tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=9V4HkG7xJ6wQ2Z1yP8mN3tL5rS0vF4eD2aB8cE1fH3g=

# Celery & Redis (Set to True for synchronous in-memory sandbox / local dev without Redis)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Base URL for tracking pixels, legacy click redirects and unsubscribe links
BASE_TRACKING_URL=http://localhost:8000

# Public base URL embedded in generated /c/<token> tracking links.
# Production: https://marketing.iriscommunications.cloud
# Local development (to receive clickable localhost links instead):
# SHORTENER_BASE_URL=http://localhost:8000
# If unset, the production domain is used. Each environment must set
# this to its own public URL: a tracking link only resolves in the
# database where its row was created, so links minted locally carry
# the local base and links minted in production carry the public base.
SHORTENER_BASE_URL=https://marketing.iriscommunications.cloud

# Default Email Sandbox Mode (stores sent emails in DB for webmail preview)
EMAIL_SANDBOX_MODE=True
